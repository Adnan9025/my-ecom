<file path="src/components/home/FeaturedProducts.jsx">
import { useState } from "react";
import { motion } from "framer-motion";
import { Link } from "react-router-dom";
import { Star, ShoppingCart } from "lucide-react";

import Badge from "../ui/Badge";
import Toast from "../ui/Toast";
import Lightbox from "../ui/Lightbox";

import { products } from "../../data/mockProducts";
import { useCart } from "../../contexts/CartContext";

export default function FeaturedProducts() {
  const { dispatch } = useCart();

  const featured = products.slice(0, 8);

  const [selectedImage, setSelectedImage] = useState(null);

  const [toast, setToast] = useState({
    show: false,
    message: "",
    type: "success",
  });

  const handleAddToCart = (product) => {
    dispatch({
      type: "ADD_TO_CART",
      payload: product,
    });

    setToast({
      show: true,
      message: `${product.title} added to cart`,
      type: "success",
    });

    setTimeout(() => {
      setToast((prev) => ({
        ...prev,
        show: false,
      }));
    }, 2500);
  };

  return (
    <section className="py-24 bg-slate-50">

      <Toast
        show={toast.show}
        message={toast.message}
        type={toast.type}
        onClose={() =>
          setToast((prev) => ({
            ...prev,
            show: false,
          }))
        }
      />

      <Lightbox
        image={selectedImage}
        isOpen={selectedImage !== null}
        onClose={() => setSelectedImage(null)}
      />

      <div className="max-w-7xl mx-auto px-6">

        {/* Heading */}

        <motion.div
          initial={{ opacity: 0, y: 40 }}
          whileInView={{ opacity: 1, y: 0 }}
          viewport={{ once: true }}
          transition={{ duration: 0.6 }}
          className="text-center mb-16"
        >
          <span className="inline-block px-5 py-2 rounded-full bg-indigo-100 text-indigo-700 font-semibold">
            Featured Collection
          </span>

          <h2 className="mt-6 text-5xl font-black text-slate-900">
            Trending Products
          </h2>

          <p className="mt-5 text-lg text-slate-500 max-w-2xl mx-auto">
            Discover our hand-picked premium collection carefully selected
            for quality, innovation, and exceptional performance.
          </p>

        </motion.div>

        {/* Products */}

        <div className="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">

          {featured.map((product, index) => (

            <motion.div
              key={product._id ?? product.id ?? index}
              initial={{ opacity: 0, y: 60 }}
              whileInView={{ opacity: 1, y: 0 }}
              whileHover={{ y: -10 }}
              viewport={{ once: true }}
              transition={{
                duration: 0.5,
                delay: index * 0.08,
              }}
              className="bg-white rounded-3xl overflow-hidden shadow-sm hover:shadow-2xl transition duration-300 group"
            >

              <div className="relative bg-slate-100 overflow-hidden">

                <img
                  src={product.image}
                  alt={product.title}
                  className="w-full h-72 object-contain p-8 transition-all duration-500 group-hover:scale-110 group-hover:rotate-1 cursor-pointer"
                  onClick={() => setSelectedImage(product.image)}
                />

                {product.sale ? (
                  <Badge type="sale">SALE</Badge>
                ) : (
                  <Badge type="new">NEW</Badge>
                )}

                <button
                  onClick={() => handleAddToCart(product)}
                  className="absolute top-5 right-5 w-11 h-11 rounded-full bg-white shadow-md flex items-center justify-center hover:bg-red-500 hover:text-white transition"
                >
                  <ShoppingCart size={18} />
                </button>

              </div>

              <div className="p-6">

                <p className="text-sm text-slate-500">
                  {product.category}
                </p>

                <h3 className="text-xl font-bold mt-2 text-slate-900 line-clamp-2">
                  {product.title}
                </h3>

                <div className="flex items-center gap-1 mt-4">

                  {[...Array(5)].map((_, i) => (
                    <Star
                      key={i}
                      size={16}
                      className="fill-yellow-400 text-yellow-400"
                    />
                  ))}

                  <span className="ml-2 text-sm text-slate-500">
                    ({product.rating || 4.9})
                  </span>

                </div>

                <div className="flex items-center justify-between mt-6">

                  <div>

                    <span className="text-3xl font-black text-indigo-600">
                      ${product.price}
                    </span>

                    {product.oldPrice && (
                      <span className="ml-3 text-slate-400 line-through">
                        ${product.oldPrice}
                      </span>
                    )}

                  </div>

                </div>

                <button
                  onClick={() => handleAddToCart(product)}
                  className="mt-7 w-full flex items-center justify-center gap-2 bg-slate-900 hover:bg-indigo-600 text-white py-4 rounded-xl font-semibold transition"
                >
                  <ShoppingCart size={18} />
                  Add to Cart
                </button>

              </div>

            </motion.div>

          ))}

        </div>

        <div className="text-center mt-20">

          <Link
            to="/products"
            className="inline-flex items-center px-10 py-4 rounded-full bg-indigo-600 hover:bg-indigo-700 text-white font-bold shadow-xl transition"
          >
            View All Products
          </Link>

        </div>

      </div>

    </section>
  );
}
</file>

